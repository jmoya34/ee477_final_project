; enable waveform output
output_wf 1
; Specify number of bits of the vector
radix 44 44 1 1
; define all as input vectors
io i i i i
; assign name to vectors
vname a[7:0] b[7:0] clk RST_b
; set time unit
tunit ns
; set rise and fall times to 10ps for each input vector
trise 0.01
tfall 0.01
; set logic high value to 1.0V and low to 0.0V
vih 1.0
vil 0.0

;time   A   B   CLK RST_b
0       00  00  0   0       ; 0,0
0.75    00  00  1   0  
1.5     55  FF  0   1       ; 85,-1
2.25    55  FF  1   1
3       FF  AA  0   1       ;-1, -86
3.75    FF  AA  1   1
4.5     FF  55  0   0       ; -1,85
5.25    FF  55  1   0
6       7F  80  0   1       ; 127, -128
6.75    7F  80  1   1
7.5     00  0F  0   1       ; 0, 15
8.25    00  0F  1   1
9       F0  20  0   1       ;-16, 32
9.75    F0  20  1   1 
10.5    6B  F4  0   0       ; 107,-12
11.25   6B  F4  1   0
12      F6  A3  0   1       ; -10, -93
12.75   F6  A3  1   1
13.5    FF  27  0   0       ; -1, 39
14.25   FF  27  1   0
15      7E  80  0   1       ; 126, -128
15.75   7E  80  1   1
16.5    00  6E  0   1       ; 0, 110
17.25   00  6E  1   1
18      C0  3F  0   1       ; -64, 63
18.75   C0  3F  1   1
19.5    80  80  0   0       ; -128,-128
20.25   80  80  1   0 
21      7F  7F  0   1       ; 127,127
21.75   7F  7F  1   1
22.5    A0  25  0   0       ; -96,37
23.25   A0  25  1   0
24      38  CE  0   1       ; 56,-50
24.75   38  CE  1   1
25.5    0D  6F  0   1       ; 13,111
26.25   0D  6F  1   1
27      2B  57  0   1       ;43, 87
27.75   2B  57  1   1
28.5    13  0F  0   1       ; 19, 15
29.25   13  0F  1   1
30      00  00  0   1       ; 0,0 
30.75   00  00  1   1
